# Copy to .env and fill in from the Supabase dashboard:
#   Project Settings > API Keys
#
# Use the PUBLISHABLE key (sb_publishable_...), not the secret one. It is safe
# to ship in a phone bundle: it carries the same low privileges the legacy anon
# key did, and Row Level Security is what actually protects the data.
#
# The legacy anon / service_role keys still work but are deprecated at the end
# of 2026, and new projects are not issued them at all.

EXPO_PUBLIC_SUPABASE_URL=https://vcoopilzlwkaazocydwf.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# EXPO_PUBLIC_ variables are inlined into the bundle at build time. After
# changing them, restart with a cleared cache: npx expo start -c
